# Copy this file to ".streamlit/secrets.toml" (git-ignored) and fill in your
# database connection string. On Streamlit Community Cloud, paste the same
# content into: App -> (three-dot menu) -> Settings -> Secrets.
#
# The app always runs on a fast LOCAL SQLite file. This database is used only as
# a durable BACKUP: it is restored into SQLite on boot and mirrored back to
# asynchronously whenever data changes. Without it, the app still works on local
# SQLite, but data is lost if the host's disk is wiped (e.g. Streamlit Cloud).

[database]
url = "postgresql://user:password@host/dbname?sslmode=require"
