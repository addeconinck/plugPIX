# Copy this file to ".streamlit/secrets.toml" (which is git-ignored) and fill in
# your database connection string. On Streamlit Community Cloud, paste the same
# content into: App → ⋮ → Settings → Secrets.
#
# Without this, the app falls back to a local SQLite file (fine for development
# and always-on servers, but NOT on ephemeral hosts like Streamlit Cloud).

[database]
url = "postgresql://user:password@host/dbname?sslmode=require"
